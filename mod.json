{
  "id": "wired-carplay-tbt-lx2pe",
  "name": "Phone Projection TBT",
  "version": "0.1.46",
  "hmgapi": ">=1.0.2",
  "authors": [
    "Local build"
  ],
  "license": "AGPL-3.0",
  "description": "Shows CarPlay turn-by-turn directions and lane guidance on the instrument cluster over wired or wireless connections. Android Auto TBT support is planned.",
  "hooks": {
    "jar": "hooks.jar",
    "entry": "hmgapi.mods.projection.ProjectionTbt",
    "points": {
      "iap2.init_info.check_supports_features": "change",
      "dipo.iap2_proxy.stop_route_guidance": "observe",
      "dipo.carplay.session_started": "observe"
    },
    "native": {
      "libiap2session.so": [
        "recipes/lane-notify-guard.recipe"
      ]
    }
  },
  "usb": [
    "TBT-LOGS"
  ],
  "services": [
    {
      "name": "usb-log-export",
      "script": "export-logs.sh",
      "user": "root",
      "start": "android",
      "restart": true
    }
  ]
}
